rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Kullanıcı profilleri: giriş yapan herkes okuyabilir, yalnızca sahibi yazabilir.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /chats/{chatId} {
      function isMember() {
        return request.auth.uid in resource.data.members;
      }

      function membersUnchanged() {
        return request.resource.data.members.toSet() == resource.data.members.toSet();
      }

      // Üye kendini listeden çıkarıyor mu (gruptan ayrılma)?
      function onlyLeaving() {
        return request.resource.data.members.toSet()
          == resource.data.members.toSet().difference([request.auth.uid].toSet());
      }

      // Henüz var olmayan bir sohbetin "var mı" diye sorulmasına izin verilir.
      allow get: if signedIn() && (resource == null || isMember());
      allow list: if signedIn() && isMember();

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdBy == request.auth.uid
        && (
          (request.resource.data.type == 'direct'
            && request.resource.data.members.size() <= 2
            && request.resource.data.admins.size() == 0)
          || (request.resource.data.type == 'group'
            && request.resource.data.admins == [request.auth.uid])
        );

      // Birebir sohbette üyeler değişmez. Grupta üyeleri ve yöneticileri yalnızca yönetici değiştirir;
      // yönetici olmayan üye yalnızca kendini çıkarabilir.
      allow update: if signedIn() && isMember()
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          (resource.data.type == 'direct'
            && membersUnchanged()
            && request.resource.data.admins.size() == 0)
          || (resource.data.type == 'group'
            && (
              request.auth.uid in resource.data.admins
              || (request.resource.data.admins.toSet() == resource.data.admins.toSet()
                  && (membersUnchanged() || onlyLeaving()))
            ))
        );

      allow delete: if false;

      match /messages/{messageId} {
        function inChat() {
          return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }

        allow read: if signedIn() && inChat();
        allow create: if signedIn() && inChat()
          && request.resource.data.senderId == request.auth.uid;
        // Mesajı yalnızca gönderen düzenleyebilir ya da silindi olarak işaretleyebilir.
        allow update: if signedIn() && inChat()
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
    }
  }
}
